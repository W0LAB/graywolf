# nfpm template for the graywolf-desktop deb/rpm. release.yml substitutes
# @VERSION@ / @ARCH@ (GOARCH) and stages the binaries in dist-desktop/;
# paths are relative to the repo root. Self-contained: ships its own
# graywolf-modem under /usr/lib/graywolf-desktop so it neither depends on
# nor conflicts with the headless `graywolf` package (whose postinstall
# enables a systemd unit -- not wanted on a desktop). The app finds the
# modem next to its real (symlink-resolved) path.
name: graywolf-desktop
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
section: hamradio
priority: optional
maintainer: Chris Snell
vendor: chrissnell
homepage: https://github.com/chrissnell/graywolf
license: GPL-2.0-only
description: |-
  APRS radio transceiver, digipeater, and Internet gateway (desktop app)
  Graywolf in its own window with a system tray icon. Runs as the
  logged-in user; no background service is installed.
depends:
  - libgtk-3-0t64 | libgtk-3-0
  - libwebkit2gtk-4.1-0
  - libasound2t64 | libasound2
  - libudev1
overrides:
  rpm:
    depends:
      - gtk3
      - webkit2gtk4.1
      - alsa-lib
      - systemd-libs
contents:
  - src: dist-desktop/graywolf-desktop
    dst: /usr/lib/graywolf-desktop/graywolf-desktop
    file_info:
      mode: 0755
  - src: dist-desktop/graywolf-modem
    dst: /usr/lib/graywolf-desktop/graywolf-modem
    file_info:
      mode: 0755
  - src: /usr/lib/graywolf-desktop/graywolf-desktop
    dst: /usr/bin/graywolf-desktop
    type: symlink
  - src: packaging/desktop/graywolf-desktop.desktop
    dst: /usr/share/applications/graywolf-desktop.desktop
  - src: packaging/desktop/70-graywolf-desktop.rules
    dst: /usr/lib/udev/rules.d/70-graywolf-desktop.rules
  - src: assets/graywolf.svg
    dst: /usr/share/icons/hicolor/scalable/apps/graywolf.svg
  - src: packaging/desktop/icons/graywolf-16.png
    dst: /usr/share/icons/hicolor/16x16/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-32.png
    dst: /usr/share/icons/hicolor/32x32/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-48.png
    dst: /usr/share/icons/hicolor/48x48/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-64.png
    dst: /usr/share/icons/hicolor/64x64/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-128.png
    dst: /usr/share/icons/hicolor/128x128/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-256.png
    dst: /usr/share/icons/hicolor/256x256/apps/graywolf.png
  - src: packaging/desktop/icons/graywolf-512.png
    dst: /usr/share/icons/hicolor/512x512/apps/graywolf.png
  - src: LICENSE
    dst: /usr/share/doc/graywolf-desktop/LICENSE
scripts:
  postinstall: packaging/desktop/postinstall.sh
  postremove: packaging/desktop/postremove.sh
